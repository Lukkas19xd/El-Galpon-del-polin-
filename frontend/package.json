{
  "name": "agroforestal-monte-redondo-frontend",
  "version": "1.0.0",
  "description": "Frontend para Agroforestal Monte Redondo SPA - Venta de polines y leña",
  "main": "index.html",
  "scripts": {
    "dev": "npm run css:watch & python3 -m http.server 8000 --directory . --bind 127.0.0.1",
    "css": "tailwindcss -i src/css/entrada.css -o src/css/estilos.css --minify",
    "css:watch": "tailwindcss -i src/css/entrada.css -o src/css/estilos.css --watch",
    "start": "python3 -m http.server 8000 --directory . --bind 127.0.0.1"
  },
  "keywords": [
    "polines",
    "venta",
    "frontend"
  ],
  "author": "Agroforestal Monte Redondo SPA",
  "license": "ISC",
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
