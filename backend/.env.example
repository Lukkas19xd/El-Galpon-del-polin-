# Base de Datos (PostgreSQL)
# Levantá un Postgres local rápido con: docker compose up -d
DATABASE_URL=postgresql://polin:polin@localhost:5433/agroforestal_monte_redondo
# Base de los tests (npm test). Si no se define, se usa la de arriba con "_test" al final;
# se crea sola y se vacía en cada corrida, así que nunca apuntes a la de desarrollo.
# DATABASE_URL_TEST=postgresql://polin:polin@localhost:5433/agroforestal_monte_redondo_test

# Servidor
PORT=3000                # Puerto donde correrá el backend
NODE_ENV=development      # development muestra detalles de los errores; en el servidor real usa production
HOST=localhost            # Host del backend

# JWT
# Clave para firmar las sesiones. Con NODE_ENV=production el servidor no arranca si es
# esta de ejemplo o tiene menos de 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion_12345
JWT_EXPIRE=7d             # Tiempo de expiración del token JWT

# Si el servidor queda detrás de un proxy (Nginx, Render, Railway...), pon 1 para que
# el límite de peticiones vea la IP real de cada cliente. En local, déjalo vacío.
TRUST_PROXY=

# CORS
FRONTEND_URL=http://localhost:8000   # Origen permitido para el frontend

# Correo de aviso de reservas (Gmail)
# GMAIL_APP_PASSWORD es una "contraseña de aplicación", no la clave normal:
# Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
# Si se deja vacío, las reservas funcionan igual pero no se envía el correo.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CORREO_RESERVAS=         # Quién recibe el aviso de cada reserva (por defecto, GMAIL_USER)

# Logs
LOG_LEVEL=info          # Nivel de logs: info, debug, warn, error
